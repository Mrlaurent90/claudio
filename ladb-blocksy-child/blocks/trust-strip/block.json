{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ladb/trust-strip",
  "version": "1.0.0",
  "title": "LADB — Bande réassurance",
  "category": "ladb",
  "description": "Bande crème avec 2 items icône + titre fort + sous-titre",
  "keywords": ["trust", "reassurance", "ladb"],
  "supports": {
    "html": false,
    "align": ["full", "wide"]
  },
  "attributes": {
    "item1Icon": { "type": "string", "default": "shield" },
    "item1Title": { "type": "string", "default": "Intervention en moins de 30 min" },
    "item1Subtitle": { "type": "string", "default": "Disponible 24h/24 — 7j/7 sur Montpellier et l'Hérault" },
    "item2Icon": { "type": "string", "default": "star" },
    "item2Title": { "type": "string", "default": "47 avis 5/5 sur Google" },
    "item2Subtitle": { "type": "string", "default": "Clients satisfaits depuis plus de 10 ans" }
  },
  "editorScript": "file:./build/index.js",
  "style": "file:./build/style-index.css",
  "editorStyle": "file:./build/index.css"
}
