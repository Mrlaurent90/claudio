{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "color": {
      "palette": [
        { "slug": "blue-stellaire", "color": "#0B1A33", "name": "Bleu nuit" },
        { "slug": "blue-abyssal",   "color": "#060D1A", "name": "Bleu abyssal" },
        { "slug": "cream",          "color": "#FAF8F4", "name": "Crème" },
        { "slug": "copper",         "color": "#B87333", "name": "Cuivre" },
        { "slug": "copper-light",   "color": "#D9A066", "name": "Cuivre clair" },
        { "slug": "copper-deep",    "color": "#9A5E27", "name": "Cuivre profond" },
        { "slug": "green-dispo",    "color": "#1FA35F", "name": "Vert disponibilité" },
        { "slug": "red-urgence",    "color": "#C8412E", "name": "Rouge urgence" },
        { "slug": "white",          "color": "#FFFFFF", "name": "Blanc" }
      ],
      "gradients": [
        {
          "slug": "gradient-copper",
          "gradient": "linear-gradient(135deg, #D9A066 0%, #B87333 45%, #9A5E27 100%)",
          "name": "Dégradé cuivre"
        }
      ],
      "duotone": []
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "\"Bricolage Grotesque\", \"Inter\", system-ui, sans-serif",
          "slug": "bricolage-grotesque",
          "name": "Bricolage Grotesque",
          "fontFace": [
            {
              "fontFamily": "Bricolage Grotesque",
              "fontWeight": "200 800",
              "fontStyle": "normal",
              "fontStretch": "75% 100%",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/BricolageGrotesque-VariableFont_opsz_wdth_wght.ttf"]
            }
          ]
        },
        {
          "fontFamily": "\"Hanken Grotesk\", \"Inter\", system-ui, sans-serif",
          "slug": "hanken-grotesk",
          "name": "Hanken Grotesk"
        }
      ],
      "fontSizes": [
        { "slug": "eyebrow", "size": "11px", "name": "Eyebrow" },
        { "slug": "small",   "size": "13px", "name": "Petit" },
        { "slug": "body",    "size": "15px", "name": "Corps" },
        { "slug": "large",   "size": "17px", "name": "Grand" },
        { "slug": "h4",      "size": "23px", "name": "H4" },
        { "slug": "h3",      "size": "28px", "name": "H3" },
        { "slug": "h2",      "size": "34px", "name": "H2" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw"]
    },
    "layout": {
      "contentSize": "1180px",
      "wideSize": "1400px"
    },
    "blocks": {
      "core/button": { "color": { "background": true, "text": true } }
    }
  },
  "styles": {
    "color": {
      "background": "#0B1A33",
      "text": "#E8EDF5"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--hanken-grotesk)",
      "fontSize": "15px",
      "lineHeight": "1.55"
    },
    "elements": {
      "link": {
        "color": { "text": "#D9A066" }
      },
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--bricolage-grotesque)",
          "fontWeight": "700"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--bricolage-grotesque)",
          "fontWeight": "700"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--bricolage-grotesque)",
          "fontWeight": "700"
        }
      }
    }
  },
  "customTemplates": [],
  "templateParts": [
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
