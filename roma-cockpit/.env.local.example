# Copy this file to .env.local and fill in your Supabase project values.
# Both are PUBLIC keys (safe to expose in the browser) — the anon key is
# meant for client use and is gated by Row Level Security.
#
# Find them in Supabase Studio → Project Settings → API.
#
# Leave them empty to run the app in local-only mode (no cross-device sync):
# all state is then kept in the browser's localStorage.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
